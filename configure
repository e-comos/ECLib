#!/usr/bin/env python3
"""
ECLib configure script
Generates config.mk for use by Makefile
"""
import curses
import os
import sys

TITLE = "ECLib Configure"

OPTIONS = [
    {
        "key": "CC",
        "label": "C Compiler",
        "type": "input",
        "default": "gcc",
    },
    {
        "key": "AR",
        "label": "Archiver",
        "type": "input",
        "default": "ar",
    },
    {
        "key": "PREFIX",
        "label": "Install prefix",
        "type": "input",
        "default": "/usr/local",
    },
    {
        "key": "ARCH",
        "label": "Target architecture",
        "type": "choice",
        "choices": ["aarch64", "x86_64", "riscv64", "arm"],
        "default": "aarch64",
    },
    {
        "key": "DEBUG",
        "label": "Debug build",
        "type": "bool",
        "default": False,
    },
    {
        "key": "BUILD_SHARED",
        "label": "Build shared library",
        "type": "bool",
        "default": False,
    },
    {
        "key": "CFLAGS",
        "label": "C compiler flags",
        "type": "input",
        "default": "-Iinclude -O2 -Wall -Wextra -fPIC",
    },
]


def draw_box(win, y, x, h, w, title=""):
    win.attron(curses.color_pair(2))
    win.border()
    if title:
        label = f" {title} "
        win.addstr(0, (w - len(label)) // 2, label, curses.color_pair(3) | curses.A_BOLD)
    win.attroff(curses.color_pair(2))


def input_field(stdscr, prompt, default, y, x, width):
    curses.echo()
    curses.curs_set(1)
    stdscr.addstr(y, x, f"{prompt}: ", curses.color_pair(1))
    stdscr.addstr(f"[{default}] ", curses.color_pair(4))
    stdscr.refresh()
    val = stdscr.getstr(y, x + len(prompt) + 2 + len(default) + 3, width).decode().strip()
    curses.noecho()
    curses.curs_set(0)
    return val if val else default


def main(stdscr):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN,    -1)
    curses.init_pair(2, curses.COLOR_BLUE,    -1)
    curses.init_pair(3, curses.COLOR_YELLOW,  -1)
    curses.init_pair(4, curses.COLOR_GREEN,   -1)
    curses.init_pair(5, curses.COLOR_BLACK,   curses.COLOR_CYAN)
    curses.init_pair(6, curses.COLOR_RED,     -1)

    rows, cols = stdscr.getmaxyx()
    values = {o["key"]: o["default"] for o in OPTIONS}
    cursor = 0

    while True:
        stdscr.clear()
        draw_box(stdscr, 0, 0, rows, cols, TITLE)

        stdscr.addstr(2, 3,
            "Arrow keys: navigate   Enter: edit   Space: toggle   S: save & exit   Q: quit",
            curses.color_pair(4))

        for i, opt in enumerate(OPTIONS):
            y = 4 + i * 2
            selected = (i == cursor)
            attr = curses.color_pair(5) | curses.A_BOLD if selected else curses.color_pair(1)

            val = values[opt["key"]]
            if opt["type"] == "bool":
                display = "[X]" if val else "[ ]"
            elif opt["type"] == "choice":
                display = f"< {val} >"
            else:
                display = str(val)

            line = f"  {opt['label']:<30} {display}"
            stdscr.addstr(y, 2, line, attr)

        # status bar
        stdscr.addstr(rows - 2, 3,
            "config.mk will be written to the project root",
            curses.color_pair(4))

        stdscr.refresh()
        key = stdscr.getch()

        if key == curses.KEY_UP:
            cursor = (cursor - 1) % len(OPTIONS)
        elif key == curses.KEY_DOWN:
            cursor = (cursor + 1) % len(OPTIONS)
        elif key in (ord('q'), ord('Q')):
            sys.exit(0)
        elif key in (ord('s'), ord('S')):
            break
        elif key in (curses.KEY_ENTER, 10, 13, ord(' ')):
            opt = OPTIONS[cursor]
            if opt["type"] == "bool":
                values[opt["key"]] = not values[opt["key"]]
            elif opt["type"] == "choice":
                choices = opt["choices"]
                idx = choices.index(values[opt["key"]])
                values[opt["key"]] = choices[(idx + 1) % len(choices)]
            elif opt["type"] == "input":
                curses.echo()
                curses.curs_set(1)
                y = 4 + cursor * 2
                prompt = f"  {opt['label']}: "
                stdscr.addstr(y, 2, prompt, curses.color_pair(3))
                stdscr.clrtoeol()
                stdscr.refresh()
                raw = stdscr.getstr(y, 2 + len(prompt), cols - len(prompt) - 6).decode().strip()
                curses.noecho()
                curses.curs_set(0)
                if raw:
                    values[opt["key"]] = raw

    return values


def write_config(values):
    arch = values["ARCH"]
    debug = values["DEBUG"]
    shared = values["BUILD_SHARED"]
    cflags = values["CFLAGS"]

    lines = [
        "# Generated by configure — do not edit manually",
        f"CC      := {values['CC']}",
        f"AR      := {values['AR']}",
        f"PREFIX  := {values['PREFIX']}",
        f"ARCH    := {arch}",
        f"DEBUG   := {'1' if debug else '0'}",
        f"CFLAGS  := {cflags}",
        f"LDLIBS  :=",
        f"BUILD_SHARED := {'1' if shared else '0'}",
    ]

    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.mk")
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Written: {path}")


if __name__ == "__main__":
    values = curses.wrapper(main)
    write_config(values)
